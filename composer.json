{
    "name": "eyawiin/filament-taxonomies",
    "description": "A flexible taxonomy and hierarchical term management plugin for Filament.",
    "keywords": [
        "Eyawiin",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-taxonomies"
    ],
    "homepage": "https://github.com/eyawiin/filament-taxonomies",
    "support": {
        "issues": "https://github.com/eyawiin/filament-taxonomies/issues",
        "source": "https://github.com/eyawiin/filament-taxonomies"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Eyawiin",
            "email": "Alexander_H_99@web.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "phpstan/extension-installer": "^1.4",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Eyawiin\\FilamentTaxonomies\\": "src/",
            "Eyawiin\\FilamentTaxonomies\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eyawiin\\FilamentTaxonomies\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare",
            "@php ./vendor/bin/testbench package:discover --ansi"
        ],
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eyawiin\\FilamentTaxonomies\\FilamentTaxonomiesServiceProvider"
            ],
            "aliases": {
                "FilamentTaxonomies": "Eyawiin\\FilamentTaxonomies\\Facades\\FilamentTaxonomies"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}